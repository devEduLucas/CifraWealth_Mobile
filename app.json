{
  "expo": {
    "name": "Cifra Wealth",
    "slug": "cifra-wealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": [
      "cifrawealth",
      "com.cifrawealth.app",
      "com.googleusercontent.apps.562450826110-farv4tu8mvvga5le9icv2kev91tp9obe"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1D"
        }
      ],
      "./plugins/withCifraQuickWidget",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permitir que o CifraWealth use o microfone para preparar lançamentos por voz.",
          "speechRecognitionPermission": "Permitir que o CifraWealth reconheça sua fala para preparar lançamentos financeiros."
        }
      ],
      "./plugins/withCifraAppFunctions"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cifrawealth.app"
    },
    "android": {
      "package": "com.cifrawealth.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0F1D"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cifrawealth.vercel.app",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "cifrawealth.vercel.app",
              "pathPrefix": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:3000/api",
      "eas": {
        "projectId": "c0b5f2ae-16c1-44ee-84ae-43d22b1078f7"
      }
    }
  }
}
